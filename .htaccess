# Growfy Agency — Apache/LiteSpeed configuration
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Default charset + UTF-8 URLs
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .svg .xml .json
</IfModule>

# Protect sensitive server-side files
<FilesMatch "^(config\.php|composer\.(json|lock)|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve database files directly
<FilesMatch "\.(db|sqlite|sqlite3|sql|bak|log|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block dotfiles (.git, .env, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Long cache for static assets
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|gif|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Friendly errors — send visitors home
ErrorDocument 404 /index.php
